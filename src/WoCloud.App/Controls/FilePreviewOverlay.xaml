<UserControl
    x:Class="WoCloud.App.Controls.FilePreviewOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Root" Background="#D9000000" Visibility="Collapsed"
          IsTabStop="True" KeyDown="Root_KeyDown" Tapped="Root_Tapped">

        <Border Margin="16" CornerRadius="12" Padding="14"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderThickness="1" BorderBrush="#22000000">
            <Grid RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 顶栏：标题 + 缩放/翻页/关闭（窗口再小也始终可见） -->
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" FontSize="14" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="SubText" FontSize="11" Foreground="#888"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"
                                VerticalAlignment="Center">
                        <Button x:Name="ZoomOutBtn" Content="−" Width="34" Click="ZoomOut_Click"
                                ToolTipService.ToolTip="缩小 (Ctrl+-)"/>
                        <TextBlock x:Name="ZoomText" Text="100%" FontSize="12" Width="46"
                                   TextAlignment="Center" VerticalAlignment="Center"/>
                        <Button x:Name="ZoomInBtn" Content="+" Width="34" Click="ZoomIn_Click"
                                ToolTipService.ToolTip="放大 (Ctrl++)"/>
                        <Button x:Name="FitBtn" Content="适应" Click="Fit_Click"
                                ToolTipService.ToolTip="适应窗口 (Ctrl+0)"/>
                        <Button x:Name="RotateBtn" Content="⟳" Width="34" Click="Rotate_Click"
                                ToolTipService.ToolTip="旋转 90°"/>
                        <Border Width="1" Background="#22000000" Margin="4,4,4,4"/>
                        <Button x:Name="PrevBtn" Content="◀" Width="34" Click="Prev_Click"
                                ToolTipService.ToolTip="上一个 (←)"/>
                        <Button x:Name="NextBtn" Content="▶" Width="34" Click="Next_Click"
                                ToolTipService.ToolTip="下一个 (→)"/>
                        <Button Content="✕" Width="34" Click="Close_Click"
                                ToolTipService.ToolTip="关闭 (Esc)"/>
                    </StackPanel>
                </Grid>

                <!-- 内容 -->
                <Grid Grid.Row="1" MinHeight="120">
                    <ScrollViewer x:Name="ImageScroll" Visibility="Collapsed"
                                  ZoomMode="Enabled" MinZoomFactor="0.2" MaxZoomFactor="8"
                                  HorizontalScrollMode="Auto" VerticalScrollMode="Auto"
                                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                  ViewChanged="ImageScroll_ViewChanged">
                        <Image x:Name="PreviewImage" Stretch="Uniform"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               RenderTransformOrigin="0.5,0.5">
                            <Image.RenderTransform>
                                <RotateTransform x:Name="PreviewRotate" Angle="0"/>
                            </Image.RenderTransform>
                        </Image>
                    </ScrollViewer>

                    <MediaPlayerElement x:Name="PreviewMedia" AreTransportControlsEnabled="True"
                                        AutoPlay="True" Visibility="Collapsed"/>

                    <ScrollViewer x:Name="TextScroll" Visibility="Collapsed"
                                  HorizontalScrollBarVisibility="Auto">
                        <TextBlock x:Name="PreviewText" FontFamily="Consolas" FontSize="12"
                                   IsTextSelectionEnabled="True" TextWrapping="Wrap"/>
                    </ScrollViewer>

                    <StackPanel x:Name="InfoPanel" Spacing="12" VerticalAlignment="Center"
                                HorizontalAlignment="Center" Visibility="Collapsed">
                        <FontIcon x:Name="InfoGlyph" Glyph="&#xE7C3;" FontSize="46" Opacity="0.45"/>
                        <TextBlock x:Name="InfoText" FontSize="13" Foreground="#888"
                                   TextAlignment="Center" TextWrapping="Wrap" MaxWidth="520"/>
                    </StackPanel>

                    <ProgressRing x:Name="LoadingRing" IsActive="False" Width="34" Height="34"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <!-- 底部操作 -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8"
                            HorizontalAlignment="Right">
                    <TextBlock x:Name="HintText" FontSize="11" Foreground="#999"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button Content="下载到…" Click="Download_Click"/>
                    <Button Content="用系统应用打开" Click="OpenExternal_Click"/>
                    <Button Content="关闭" Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
