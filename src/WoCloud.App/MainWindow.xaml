<Window
    x:Class="WoCloud.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="WoCloud 联通云盘">

    <Grid>
        <NavigationView x:Name="Nav"
                        PaneDisplayMode="Left"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        SelectionChanged="Nav_SelectionChanged"
                        Background="Transparent">
            <NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
            </NavigationView.Resources>
            <NavigationView.PaneHeader>
                <StackPanel Margin="16,12,0,8" Orientation="Horizontal" Spacing="10">
                    <Image Source="ms-appx:///Assets/logo-mark.png" Width="34" Height="34"
                           Stretch="Uniform" VerticalAlignment="Center"/>
                    <TextBlock Text="联通云盘" FontSize="17" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>
            </NavigationView.PaneHeader>

            <!-- 右上角个人信息 -->
            <NavigationView.Header>
                <Grid Height="46" Margin="0,0,140,0">
                    <StackPanel x:Name="UserChip" Orientation="Horizontal" Spacing="10"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Background="Transparent" Visibility="Collapsed"
                                Tapped="UserChip_Tapped" ToolTipService.ToolTip="查看会员空间">
                        <Border Width="30" Height="30" CornerRadius="15" Background="#1F6CBD">
                            <Grid>
                                <FontIcon x:Name="AvatarFallback" Glyph="&#xE77B;" FontSize="14"
                                          Foreground="White" Visibility="Collapsed"/>
                                <Image x:Name="AvatarImage" Stretch="UniformToFill" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="UserNameText" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock x:Name="LevelTextBlock" FontSize="11" Foreground="#888"/>
                        </StackPanel>
                        <FontIcon Glyph="&#xE76C;" FontSize="10" Foreground="#999" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </NavigationView.Header>
            <NavigationView.MenuItems>
                <NavigationViewItem Tag="files" Content="我的文件">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8B7;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="transfer" Content="传输队列">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE896;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="share" Content="分享管理">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE72D;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="flypass" Content="飞传接收站">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE898;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="recycle" Content="回收站">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE74D;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="private" Content="私密空间">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE72E;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="member" Content="会员空间">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE719;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="lab" Content="调试面板">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE943;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Tag="settings" Content="设置">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <Frame x:Name="ContentFrame" Padding="24,18,24,24"/>
        </NavigationView>
    </Grid>
</Window>
