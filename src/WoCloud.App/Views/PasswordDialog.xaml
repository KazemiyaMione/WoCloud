<ContentDialog
    x:Class="WoCloud.App.Views.PasswordDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="修改登录密码"
    PrimaryButtonText="确认修改"
    CloseButtonText="取消"
    DefaultButton="Primary">

    <StackPanel Spacing="12" MinWidth="380">

        <TextBlock x:Name="PhoneText" FontSize="13" Opacity="0.7" Text="正在读取账号…"/>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="CodeBox" Header="短信验证码" MaxLength="6" PlaceholderText="6 位数字"/>
            <Button x:Name="SendBtn" Grid.Column="1" Content="获取验证码"
                    Click="Send_Click" VerticalAlignment="Bottom"/>
        </Grid>

        <PasswordBox x:Name="PwdBox" Header="新密码" PlaceholderText="6-20 位，建议字母 + 数字"/>
        <PasswordBox x:Name="Pwd2Box" Header="确认新密码" PlaceholderText="再次输入新密码"/>

        <TextBlock FontSize="11" Opacity="0.55" TextWrapping="Wrap"
                   Text="修改成功后当前登录可能失效，需要用新密码重新登录。"/>

        <InfoBar x:Name="ErrBar" IsOpen="False" IsClosable="False" Severity="Error"/>
    </StackPanel>
</ContentDialog>
