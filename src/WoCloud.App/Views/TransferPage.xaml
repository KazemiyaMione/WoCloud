<Page
    x:Class="WoCloud.App.Views.TransferPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock Text="传输队列" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="{x:Bind Vm.StatusText, Mode=OneWay}" FontSize="12" Foreground="#888"/>
            </StackPanel>
            <Button Grid.Column="1" Content="清理已完成" Click="ClearFinished_Click" VerticalAlignment="Center"/>
            <Button Grid.Column="2" Content="全部清空" Click="ClearAll_Click" VerticalAlignment="Center"/>
        </Grid>

        <TextBlock Grid.Row="1" Text="暂无传输任务，去「文件」页上传或下载试试"
                   FontSize="13" Foreground="#999" HorizontalAlignment="Center" Margin="0,24,0,0"
                   Visibility="{x:Bind EmptyVisible, Mode=OneWay}"/>

        <ListView Grid.Row="2" ItemsSource="{x:Bind Vm.Items, Mode=OneWay}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:TransferItem" xmlns:vm="using:WoCloud.App.ViewModels">
                    <Grid ColumnSpacing="14" Padding="12,10" CornerRadius="8" Background="#0A0F6CBD" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <FontIcon Glyph="&#xE896;" FontSize="18" VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" Spacing="5">
                            <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" FontSize="13"/>
                            <ProgressBar Value="{x:Bind Progress, Mode=OneWay}" Maximum="1"
                                         Height="4" CornerRadius="2"/>
                            <TextBlock Text="{x:Bind State, Mode=OneWay}" FontSize="11" Foreground="#888"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind SizeText, Mode=OneWay}" FontSize="12" Foreground="#666"
                                       TextAlignment="Right"/>
                            <TextBlock Text="{x:Bind TimeText}" FontSize="11" Foreground="#999"
                                       TextAlignment="Right"/>
                        </StackPanel>

                        <TextBlock Grid.Column="3" Text="{x:Bind Kind}" FontSize="12" Foreground="#888"
                                   VerticalAlignment="Center" MinWidth="34"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
