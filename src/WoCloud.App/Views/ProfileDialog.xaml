<ContentDialog
    x:Class="WoCloud.App.Views.ProfileDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="个人资料"
    PrimaryButtonText="保存"
    CloseButtonText="取消"
    DefaultButton="Primary">

    <StackPanel Spacing="14" MinWidth="380">

        <Grid ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Width="64" Height="64" CornerRadius="32" Background="#1F6CBD">
                <Image x:Name="AvatarImage" Stretch="UniformToFill"/>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                <Button Content="更改头像" Click="PickAvatar_Click"/>
                <TextBlock x:Name="AvatarHint" FontSize="11" Opacity="0.6"
                           Text="jpg / png / gif，单张不超过 10 MB"/>
            </StackPanel>
        </Grid>

        <TextBox x:Name="NameBox" Header="昵称" MaxLength="20" PlaceholderText="请输入昵称"/>

        <ComboBox x:Name="SexBox" Header="性别" HorizontalAlignment="Stretch" PlaceholderText="请选择">
            <ComboBoxItem Content="男" Tag="1"/>
            <ComboBoxItem Content="女" Tag="2"/>
        </ComboBox>

        <DatePicker x:Name="BirthdayPicker" Header="生日" HorizontalAlignment="Stretch"/>

        <InfoBar x:Name="ErrBar" IsOpen="False" IsClosable="False" Severity="Error"/>
    </StackPanel>
</ContentDialog>
