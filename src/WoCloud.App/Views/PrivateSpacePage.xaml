<Page
    x:Class="WoCloud.App.Views.PrivateSpacePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WoCloud.App.Controls">

    <Grid RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="私密空间" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="🔒 锁定" Click="Lock_Click"
                    Visibility="{x:Bind Vm.IsUnlocked, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
            <Button Grid.Column="2" Content="⟳ 刷新" Click="Refresh_Click"
                    Visibility="{x:Bind Vm.IsUnlocked, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
        </Grid>

        <!-- 解锁面板 -->
        <Border Grid.Row="1" CornerRadius="14" Padding="22,20" Background="#0A0F6CBD"
                Visibility="{x:Bind Vm.IsUnlocked, Mode=OneWay, Converter={StaticResource BoolToVisCollapsed}}">
            <StackPanel Spacing="14" MaxWidth="460" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon Glyph="&#xE72E;" FontSize="18" Foreground="#0F6CBD"/>
                    <TextBlock Text="私密空间已加密" FontSize="16" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock FontSize="13" Foreground="#7A8794" TextWrapping="Wrap"
                           Text="输入私密空间密码以解密浏览。连续输错会被服务端临时锁定，冷却前无法解锁。"/>

                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <PasswordBox x:Name="PwdBox" PlaceholderText="私密空间密码"
                                 PasswordChanged="Password_Changed" KeyDown="Password_KeyDown"
                                 HorizontalAlignment="Stretch"/>
                    <Button Grid.Column="1" Content="解锁" Style="{StaticResource AccentButtonStyle}"
                            Click="Unlock_Click" IsEnabled="{x:Bind Vm.IsNotLoading, Mode=OneWay}"/>
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="8"
                            Visibility="{x:Bind Vm.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <ProgressRing IsActive="{x:Bind Vm.IsLoading, Mode=OneWay}" Width="16" Height="16"/>
                    <TextBlock Text="{x:Bind Vm.StatusText, Mode=OneWay}" FontSize="12"
                               Foreground="#7A8794" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 密码被服务端锁定 -->
                <InfoBar IsOpen="{x:Bind Vm.IsLockedOut, Mode=OneWay}"
                         IsClosable="False" Severity="Error"
                         Title="密码已被临时锁定"
                         Message="{x:Bind Vm.StatusText, Mode=OneWay}"
                         Visibility="{x:Bind Vm.IsLockedOut, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>

                <TextBlock FontSize="12" Foreground="#8A94A0"
                           Text="提示：首次使用需先在官方网页设置密码；忘记密码可在网页端「私密空间 → 忘记密码」用短信重置。"/>
            </StackPanel>
        </Border>

        <!-- 已解锁：状态条 -->
        <InfoBar Grid.Row="1" IsOpen="True" IsClosable="False" Severity="Informational"
                 Message="{x:Bind Vm.StatusText, Mode=OneWay}"
                 Visibility="{x:Bind Vm.IsUnlocked, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>

        <!-- 未解锁：占位提示 -->
        <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12"
                    Visibility="{x:Bind Vm.IsUnlocked, Mode=OneWay, Converter={StaticResource BoolToVisCollapsed}}">
            <FontIcon Glyph="&#xE72E;" FontSize="44" Foreground="#C9D3DE"/>
            <TextBlock Text="私密空间已锁定" FontSize="15" Foreground="#8A94A0" HorizontalAlignment="Center"/>
            <TextBlock Text="解锁后可查看、下载或移出其中的文件" FontSize="12" Foreground="#AAB4BF"
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <ListView Grid.Row="2" ItemsSource="{x:Bind Vm.Files, Mode=OneWay}"
                  SelectedItem="{x:Bind Vm.Selected, Mode=TwoWay}" SelectionMode="Single"
                  IsItemClickEnabled="True" ItemClick="File_ItemClick"
                  Visibility="{x:Bind Vm.IsUnlocked, Mode=OneWay, Converter={StaticResource BoolToVis}}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="m:CloudFile" xmlns:m="using:WoCloud.Client.Models">
                    <Grid ColumnSpacing="12" Padding="8,6" RightTapped="Item_RightTapped">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>

                        <!-- 图标：类型字形（带颜色） → 文档扩展名角标 → 缩略图（失败自动露出前两者） -->
                        <Grid Width="40" Height="32" VerticalAlignment="Center">
                            <FontIcon Glyph="{x:Bind IconGlyph}"
                                      Foreground="{x:Bind IconColor, Converter={StaticResource HexToBrush}}"
                                      FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                            <Border CornerRadius="3" Padding="4,1" MinWidth="28"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Background="{x:Bind IconColor, Converter={StaticResource HexToBrush}}"
                                    Visibility="{x:Bind BadgeText, Converter={StaticResource StringToVis}}">
                                <TextBlock Text="{x:Bind BadgeText}" FontSize="9" FontWeight="Bold"
                                           Foreground="White" HorizontalAlignment="Center"/>
                            </Border>

                            <Border CornerRadius="4" Background="Transparent"
                                    Visibility="{x:Bind HasThumb, Converter={StaticResource BoolToVis}}">
                                <Image Source="{x:Bind ThumbUrl, Converter={StaticResource UrlToBitmap}}"
                                       Stretch="UniformToFill" ImageFailed="Thumb_ImageFailed"/>
                            </Border>
                        </Grid>

                        <TextBlock Grid.Column="1" Text="{x:Bind Name}" FontSize="14"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{x:Bind SizeText}" FontSize="12"
                                   Foreground="#888" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="{x:Bind TimeText}" FontSize="12"
                                   Foreground="#888" VerticalAlignment="Center"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>

            <ListView.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="预览" Click="Preview_Click"/>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem Text="移出到个人云" Click="MoveOut_Click"/>
                    <MenuFlyoutItem Text="下载到…" Click="Download_Click"/>
                </MenuFlyout>
            </ListView.ContextFlyout>
        </ListView>

        <!-- 预览浮层（私密空间：spaceType=4 + psToken） -->
        <controls:FilePreviewOverlay x:Name="Preview" Grid.RowSpan="3"/>
    </Grid>
</Page>
