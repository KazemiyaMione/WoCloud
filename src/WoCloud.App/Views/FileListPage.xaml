<Page
    x:Class="WoCloud.App.Views.FileListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WoCloud.App.Controls">

    <Grid RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="＋ 新建文件夹" Click="NewFolder_Click"/>
                <Button Content="⇧ 上传文件" Click="Upload_Click"/>
                <Button Content="⇪ 上传文件夹" Click="UploadFolder_Click"/>
            </StackPanel>
            <ComboBox Grid.Column="1" MinWidth="180" PlaceholderText="空间"
                      ItemsSource="{x:Bind Vm.Spaces, Mode=OneWay}"
                      SelectedItem="{x:Bind Vm.SelectedSpace, Mode=OneWay}"
                      SelectionChanged="Space_SelectionChanged"/>
            <TextBox Grid.Column="2" PlaceholderText="搜索文件…" MaxWidth="360"
                     HorizontalAlignment="Right"
                     Text="{x:Bind Vm.SearchKeyword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     KeyDown="Search_KeyDown"/>
            <Button Grid.Column="3" Content="搜索" Command="{x:Bind Vm.SearchCommand}"/>
            <Button Grid.Column="4" Content="⟳" Click="Refresh_Click"/>
        </Grid>

        <!-- 分类 -->
        <SelectorBar x:Name="CategoryBar" Grid.Row="1" SelectionChanged="Category_SelectionChanged">
            <SelectorBarItem Text="全部" Tag="all" IsSelected="True"/>
            <SelectorBarItem Text="照片" Tag="photo"/>
            <SelectorBarItem Text="视频" Tag="video"/>
            <SelectorBarItem Text="音乐" Tag="music"/>
            <SelectorBarItem Text="文档" Tag="file"/>
            <SelectorBarItem Text="其他" Tag="other"/>
        </SelectorBar>

        <!-- 面包屑 -->
        <ItemsControl Grid.Row="2" ItemsSource="{x:Bind Vm.Breadcrumbs, Mode=OneWay}"
                      Margin="0,0,0,-6">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:CrumbNode" xmlns:vm="using:WoCloud.App.ViewModels">
                    <StackPanel Orientation="Horizontal">
                        <HyperlinkButton Content="{x:Bind Name}" Padding="4,2"
                                         Click="Crumb_Click"/>
                        <TextBlock Text="/" Foreground="#AAA" VerticalAlignment="Center"/>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 列表 -->
        <ListView Grid.Row="3" x:Name="FileList" ItemsSource="{x:Bind Vm.Files, Mode=OneWay}"
                  SelectionMode="Single"
                  SelectedItem="{x:Bind Vm.SelectedFile, Mode=TwoWay}"
                  IsItemClickEnabled="True" ItemClick="File_ItemClick"
                  SelectionChanged="File_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="m:CloudFile" xmlns:m="using:WoCloud.Client.Models">
                    <Grid ColumnSpacing="14" Padding="8,6" RightTapped="Item_RightTapped">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>

                        <!-- 图标：类型字形（带颜色） → 文档扩展名角标 → 缩略图（失败自动露出前两者） -->
                        <Grid Width="40" Height="32" VerticalAlignment="Center">
                            <FontIcon Glyph="{x:Bind IconGlyph}"
                                      Foreground="{x:Bind IconColor, Converter={StaticResource HexToBrush}}"
                                      FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                            <Border CornerRadius="3" Padding="4,1" MinWidth="28"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Background="{x:Bind IconColor, Converter={StaticResource HexToBrush}}"
                                    Visibility="{x:Bind BadgeText, Converter={StaticResource StringToVis}}">
                                <TextBlock Text="{x:Bind BadgeText}" FontSize="9" FontWeight="Bold"
                                           Foreground="White" HorizontalAlignment="Center"/>
                            </Border>

                            <Border CornerRadius="4" Background="Transparent"
                                    Visibility="{x:Bind HasThumb, Converter={StaticResource BoolToVis}}">
                                <Image Source="{x:Bind ThumbUrl, Converter={StaticResource UrlToBitmap}}"
                                       Stretch="UniformToFill" ImageFailed="Thumb_ImageFailed"/>
                            </Border>
                        </Grid>
                        <TextBlock Grid.Column="1" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" FontSize="14"/>
                        <TextBlock Grid.Column="2" Text="{x:Bind SizeText}" Foreground="#888"
                                   FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="{x:Bind TimeText}" Foreground="#888"
                                   FontSize="12" VerticalAlignment="Center"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
            <ListView.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="下载到默认目录" Click="DownloadDefault_Click"/>
                <MenuFlyoutItem Text="下载到…" Click="Download_Click"/>
                    <MenuFlyoutItem Text="创建分享" Click="Share_Click"/>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem Text="移动到…" Click="Move_Click"/>
                    <MenuFlyoutItem Text="复制到…" Click="Copy_Click"/>
                    <MenuFlyoutItem x:Name="MoveInPrivateItem" Text="移入私密空间" Click="MoveToPrivate_Click"/>
                    <MenuFlyoutItem x:Name="MoveOutPrivateItem" Text="移出私密空间（到个人云）"
                                    Click="MoveOutPrivate_Click" Visibility="Collapsed"/>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem Text="预览" Click="Preview_Click"/>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem Text="重命名" Click="Rename_Click"/>
                    <MenuFlyoutItem Text="删除" Click="Delete_Click"/>
                </MenuFlyout>
            </ListView.ContextFlyout>
        </ListView>

        <!-- 操作结果提示（上传/下载/移动/复制/删除/重命名 都回显在这里） -->
        <InfoBar Grid.Row="4" IsOpen="{x:Bind HasStatus, Mode=OneWay}" IsClosable="True"
                 Severity="Informational" Margin="0,6,0,0"
                 Message="{x:Bind Vm.StatusText, Mode=OneWay}"
                 Visibility="{x:Bind HasStatus, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>

        <!-- 加载更多 -->
        <Button Grid.Row="3" Content="加载更多…" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Click="LoadMore_Click"
                Visibility="{x:Bind Vm.HasMore, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>

        <!-- 状态条 -->
        <InfoBar Grid.Row="3" VerticalAlignment="Bottom" HorizontalAlignment="Right"
                 IsOpen="{x:Bind HasStatus, Mode=OneWay}" IsClosable="False"
                 Severity="Informational" Message="{x:Bind Vm.StatusText, Mode=OneWay}"/>

        <!-- 预览浮层（通用控件：缩放/旋转/翻页） -->
        <controls:FilePreviewOverlay x:Name="Preview" Grid.RowSpan="4"/>
    </Grid>
</Page>
